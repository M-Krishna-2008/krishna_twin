# Required: Your OpenRouter API Key
OPENROUTER_API_KEY=

# Optional: OpenRouter Model ID (default: google/gemma-4-26b-a4b-it:free)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Port (defaults to 5000)
PORT=5000

# CORS Allowed Origin (e.g. https://<your-username>.github.io or * for all)
ALLOWED_ORIGIN=*
